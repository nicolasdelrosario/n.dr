---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { content } from '../../data/content';
const copy = content.es;
const posts = (await getCollection('blog')).filter((post) => post.data.language === 'es' && post.data.published).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BlogLayout copy={copy} title="Blog" description="Notas sobre software, herramientas y procesos de desarrollo." alternate="/en/blog/"><section class="blog-index" aria-labelledby="blog-index-title"><h2 id="blog-index-title">Artículos</h2><div class="blog-list">{posts.map((post) => <a class="blog-card" href={`/blog/${post.id.split('/').pop()}/`}><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('es-PE', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' })}</time><h3>{post.data.title}</h3><p>{post.data.description}</p><span>Leer artículo <span aria-hidden="true">↗</span></span></a>)}</div></section></BlogLayout>
