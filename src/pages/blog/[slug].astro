---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { content } from '../../data/content';
export async function getStaticPaths() { return (await getCollection('blog')).filter((post) => post.data.language === 'es').map((post) => ({ params: { slug: post.id.split('/').pop() }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogLayout copy={{ ...content.es, date: post.data.date, author: post.data.author }} title={post.data.title} description={post.data.description} alternate={post.data.alternate} isArticle><article class="blog-article"><p class="blog-date"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('es-PE', { dateStyle: 'long', timeZone: 'UTC' })}</time></p><Content /></article></BlogLayout>
