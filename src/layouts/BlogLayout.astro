---
import BaseLayout from './BaseLayout.astro';
const { copy, title, description, alternate, isArticle = false } = Astro.props;
const fallbackAlternate = Astro.url.pathname.startsWith('/en/') ? Astro.url.pathname.replace(/^\/en/, '') : `/en${Astro.url.pathname}`;
const alternatePath = typeof alternate === 'string' && alternate.length > 0 ? alternate : fallbackAlternate;
---
<BaseLayout copy={{ ...copy, title, description }} alternate={alternatePath} isArticle={isArticle}>
  <div class="blog-shell"><header class="blog-header"><p class="eyebrow">{copy.nav.blog}</p><p class="blog-kicker">{copy.location}</p><h1>{title}</h1><p class="blog-description">{description}</p><a class="blog-language" href={alternatePath}>{copy.languageName}</a></header><slot /></div>
</BaseLayout>
