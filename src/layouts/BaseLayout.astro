---
import '../styles/global.css';
import SidebarNav from '../components/SidebarNav.astro';
const { copy, isBlog = false } = Astro.props;
---
<!doctype html><html lang={copy.locale}><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="description" content={copy.description} /><meta name="theme-color" content="oklch(96% 0.018 82)" data-light-theme="oklch(96% 0.018 82)" data-dark-theme="oklch(14% 0.012 82)" data-light-label={copy.labels.switchToDarkTheme} data-dark-label={copy.labels.switchToLightTheme} data-light-action={copy.labels.switchToDarkTheme} data-dark-action={copy.labels.switchToLightTheme} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{copy.title}</title>
</head><body><a class="skip-link" href="#main">Skip to content</a><SidebarNav copy={copy} /><main id="main"><slot /></main><script is:inline>(()=>{const saved=localStorage.getItem('theme');const root=document.documentElement;const initialTheme=saved||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');const themeMeta=document.querySelector('meta[name="theme-color"]');root.dataset.theme=initialTheme;const setTheme=(theme)=>{root.dataset.theme=theme;localStorage.setItem('theme',theme);const isDark=theme==='dark';const nextLabel=isDark?themeMeta?.dataset.darkLabel||'':themeMeta?.dataset.lightLabel||'';const nextAction=isDark?themeMeta?.dataset.darkAction||'':themeMeta?.dataset.lightAction||'';button?.setAttribute('aria-pressed',String(isDark));button?.setAttribute('aria-label',nextAction);if(label)label.textContent=nextLabel;if(themeMeta)themeMeta.setAttribute('content',isDark?themeMeta.dataset.darkTheme||'oklch(14% 0.012 82)':themeMeta.dataset.lightTheme||'oklch(96% 0.018 82)')};let button;let label;const init=()=>{button=document.querySelector('[data-theme-toggle]');label=document.querySelector('[data-theme-label]');setTheme(root.dataset.theme||'light');button?.addEventListener('click',()=>setTheme(root.dataset.theme==='dark'?'light':'dark'))};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()})();</script></body></html>
